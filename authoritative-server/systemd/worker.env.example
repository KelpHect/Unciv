# Copy to /etc/unciv-authoritative/worker.env with mode 0640 and ownership
# root:unciv-authoritative. Generate the secret with `openssl rand -hex 32`.
UNCIV_ENGINE_WORKER_PORT=43170
UNCIV_ENGINE_WORKER_SECRET=replace-with-64-lowercase-hex-characters
UNCIV_ENGINE_WORKER_SOCKET_TIMEOUT_MS=5000
UNCIV_ENGINE_WORKER_COMMAND_TIMEOUT_MS=30000
