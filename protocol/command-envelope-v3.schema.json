{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kelphect.github.io/unciv/protocol/command-envelope-v3.schema.json",
  "title": "Unciv API v3 command envelope",
  "type": "object",
  "required": ["protocol_version", "game_id", "command_id", "expected_revision", "command"],
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "const": 3 },
    "game_id": { "type": "string", "minLength": 1 },
    "command_id": { "type": "string", "minLength": 1 },
    "expected_revision": { "type": "integer", "minimum": 0 },
    "client_observed_state_hash": { "type": "string" },
    "command": {
      "oneOf": [
        { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "const": "join_game" } } },
        { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "const": "end_turn" } } },
        { "type": "object", "required": ["type", "unit_id", "destination_x", "destination_y"], "additionalProperties": false, "properties": { "type": { "const": "move_unit" }, "unit_id": { "type": "integer", "minimum": 0 }, "destination_x": { "type": "integer" }, "destination_y": { "type": "integer" } } }
      ]
    }
  }
}
