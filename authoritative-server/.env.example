# PostgreSQL 19 Beta 2 is the sole current API-v3 database target.
# Use a generated value and never commit the populated .env file.
UNCIV_V3_POSTGRES_PASSWORD=replace-with-a-long-random-password
UNCIV_V3_POSTGRES_PORT=5432
# Bounded Rust runtime-pool defaults. Production credentials belong in separate
# root-owned API and migration environment files, never in this development file.
UNCIV_V3_DB_POOL_MAX=10
UNCIV_V3_DB_POOL_MIN=1
UNCIV_V3_DB_ACQUIRE_TIMEOUT_MS=5000
UNCIV_V3_DB_IDLE_TIMEOUT_SECONDS=300
UNCIV_V3_DB_MAX_LIFETIME_SECONDS=1800
UNCIV_V3_DB_STATEMENT_TIMEOUT_MS=15000
UNCIV_V3_DB_LOCK_TIMEOUT_MS=5000
# Login issuance keeps at most this many active sessions per account. Valid
# production values are 1-32; the default is 8.
UNCIV_V3_MAX_ACTIVE_SESSIONS=8
# Development talks to Rust directly. Production sets loopback and admits only
# the checked-in Caddy boundary while keeping UNCIV_V3_BIND on 127.0.0.1.
UNCIV_V3_TRUSTED_PROXY=disabled
# Generate independently with `openssl rand -hex 32`. The Rust control plane
# and private Kotlin worker must receive the same value through secret storage.
UNCIV_ENGINE_WORKER_SECRET=replace-with-exactly-64-hexadecimal-characters
# Optional Lockwell native object storage for verified cold-snapshot archival.
# Automatic archival is disabled until all four values are injected securely.
# UNCIV_LOCKWELL_ENDPOINT=https://lockwell.example
# UNCIV_LOCKWELL_BUCKET=unciv-snapshots
# UNCIV_LOCKWELL_ACCESS_KEY_ID=replace-with-native-access-key
# UNCIV_LOCKWELL_SECRET_KEY=replace-with-native-secret-key
UNCIV_V3_SNAPSHOT_ARCHIVE_ENABLED=false
UNCIV_V3_SNAPSHOT_ARCHIVE_INTERVAL_SECONDS=60
UNCIV_V3_SNAPSHOT_ARCHIVE_RECENT_REVISIONS=64
UNCIV_V3_SNAPSHOT_ARCHIVE_LONG_TERM_INTERVAL=100
UNCIV_V3_SNAPSHOT_ARCHIVE_MAX_GAMES=4
UNCIV_V3_SNAPSHOT_ARCHIVE_MAX_REVISIONS=128
UNCIV_V3_SNAPSHOT_ARCHIVE_USE_DELTAS=true
# 0 disables the external Lockwell quota. When nonzero, verified archive
# objects are never allowed to grow beyond this aggregate byte budget; cold
# archival pauses and emits metrics when the quota is reached.
UNCIV_V3_SNAPSHOT_ARCHIVE_BUDGET_BYTES=0
# 0 disables the guard. When nonzero, a game is archived after its retained
# PostgreSQL payload bytes cross this per-game budget; maintenance reports if
# protected checkpoints still keep it above the limit.
UNCIV_V3_SNAPSHOT_POSTGRES_BUDGET_BYTES=0
# 0 disables the per-match guard. When nonzero, a match whose retained
# PostgreSQL payloads plus verified Lockwell archive objects exceed this byte
# ceiling is flagged and its further cold archival is paused, so one runaway
# match cannot consume the whole archive.
UNCIV_V3_SNAPSHOT_GAME_BUDGET_BYTES=0
