[Unit]
Description=Unciv API v3 authoritative Rust control plane
Documentation=file:/opt/unciv-authoritative/docs/authoritative-api-systemd.md
Wants=network-online.target
After=network-online.target unciv-authoritative-postgres.service unciv-authoritative-worker.service
Requires=unciv-authoritative-postgres.service unciv-authoritative-worker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=unciv-api
Group=unciv-api
WorkingDirectory=/opt/unciv-authoritative/releases/current
EnvironmentFile=/etc/unciv-authoritative/api/api.env
ExecStart=/opt/unciv-authoritative/releases/current/bin/unciv-authoritative-server
Restart=on-failure
RestartSec=2s
TimeoutStartSec=45s
TimeoutStopSec=30s

CPUQuota=60%
MemoryHigh=160M
MemoryMax=192M
MemorySwapMax=0
TasksMax=64
LimitNOFILE=4096
OOMPolicy=stop

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

[Install]
WantedBy=multi-user.target
