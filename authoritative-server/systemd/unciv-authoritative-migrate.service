[Unit]
Description=Apply the exact Unciv API v3 PostgreSQL migration set
Documentation=file:/opt/unciv-authoritative/docs/authoritative-api-systemd.md
Wants=network-online.target
After=network-online.target unciv-authoritative-postgres.service
Requires=unciv-authoritative-postgres.service

[Service]
Type=oneshot
User=unciv-migrate
Group=unciv-migrate
WorkingDirectory=/opt/unciv-authoritative/releases/current
EnvironmentFile=/etc/unciv-authoritative/migration/migration.env
ExecStart=/opt/unciv-authoritative/releases/current/bin/unciv-v3-migrate
TimeoutStartSec=10min

CPUQuota=50%
MemoryMax=192M
MemorySwapMax=0
TasksMax=32
LimitNOFILE=1024

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077
