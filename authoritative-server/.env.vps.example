UNCIV_V3_RELEASE_BUNDLE=/opt/unciv-authoritative/releases/current
UNCIV_V3_RELEASE_BUNDLE_ID=replace-with-bundle-id
UNCIV_V3_SOURCE_ASSETS=/opt/unciv-authoritative/reviewed-assets
UNCIV_V3_RULESETS_ROOT=/opt/unciv-authoritative/rulesets
UNCIV_V3_RULESET_POLICY=/etc/unciv-authoritative/ruleset-policy.json
UNCIV_V3_PUBLIC_BIND=127.0.0.1
UNCIV_V3_PUBLIC_PORT=3000
UNCIV_V3_TRUSTED_PROXY=disabled
UNCIV_ENGINE_WORKER_SECRET=replace-with-64-lowercase-hex-characters
UNCIV_V3_POSTGRES_PASSWORD=replace-with-random-bootstrap-password
UNCIV_V3_RUNTIME_DB_PASSWORD=replace-with-random-runtime-password
UNCIV_V3_MIGRATION_DB_PASSWORD=replace-with-random-migration-password
UNCIV_V3_BACKUP_DB_PASSWORD=replace-with-random-backup-password
UNCIV_V3_RESTORE_DB_PASSWORD=replace-with-random-restore-password
UNCIV_V3_AUDIT_DB_PASSWORD=replace-with-random-audit-password
