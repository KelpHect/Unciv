# PostgreSQL 19 Beta 2 is the sole current API-v3 database target.
# Use a generated value and never commit the populated .env file.
UNCIV_V3_POSTGRES_PASSWORD=replace-with-a-long-random-password
UNCIV_V3_POSTGRES_PORT=5432
# Generate independently with `openssl rand -hex 32`. The Rust control plane
# and private Kotlin worker must receive the same value through secret storage.
UNCIV_ENGINE_WORKER_SECRET=replace-with-exactly-64-hexadecimal-characters
